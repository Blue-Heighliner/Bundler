[Unit]
Description=ChromaDB vector database
After=network.target

[Service]
ExecStart=/opt/chroma-db/venv/bin/chroma run --path /var/lib/chroma-db --host 127.0.0.1 --port 8000
User=chroma
Group=chroma
WorkingDirectory=/var/lib/chroma-db
Environment=HOME=/var/lib/chroma-db
Environment=ANONYMIZED_TELEMETRY=False
Environment=HF_HUB_OFFLINE=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
